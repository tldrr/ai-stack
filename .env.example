# ai-stack creates the two local secrets during `.\ai-stack.ps1 setup`.
COMPOSE_PROJECT_NAME=ai-stack

# LiteLLM: GitHub Copilot subscription models and optional OpenAI embeddings.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.95.0
LITELLM_PORT=4000
LITELLM_MASTER_KEY=change-me-generated-by-setup
OPENAI_API_KEY=

# AgentMemory 0.9.28 / iii 0.11.2.
AGENTMEMORY_REST_PORT=3111
AGENTMEMORY_VIEWER_PORT=3113
AGENTMEMORY_LLM_MODEL=gpt-5.6-sol
AGENTMEMORY_EMBEDDING_PROVIDER=local

# Optional remotely managed Cloudflare Tunnel. Configure both public hostnames
# in the Cloudflare dashboard before starting the `tunnel` Compose profile.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_REST_HOSTNAME=memory-api.example.com
CLOUDFLARE_VIEWER_HOSTNAME=memory.example.com
